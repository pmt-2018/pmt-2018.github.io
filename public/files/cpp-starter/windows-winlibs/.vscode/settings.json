{
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerPath": "C:/mingw64/bin/g++.exe",
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.ignoreSelection": true,
  "code-runner.fileDirectoryAsCwd": true,
  "code-runner.preserveFocus": false,
  "debug.onTaskErrors": "abort",
  "files.encoding": "utf8",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "terminal.integrated.profiles.windows": {
    "Command Prompt": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "args": [
        "/d"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.env.windows": {
    "PATH": "C:/mingw64/bin;${env:PATH}"
  },
  "code-runner.executorMap": {
    "cpp": "cd /d $dirWithoutTrailingSlash && \"C:/mingw64/bin/g++.exe\" -std=c++20 -Wall -Wextra -Wpedantic -g \"$fileName\" -o \"$fileNameWithoutExt.exe\" && \".\\$fileNameWithoutExt.exe\""
  }
}
