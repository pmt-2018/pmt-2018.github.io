[["Map",1,2,9,10,28,29,83,84],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.16.0","content-config-digest","a19d81077a4e5215","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://pmt-2018.github.io\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[\"cpp\",\"bash\",\"javascript\",\"typescript\",\"json\",\"yaml\",\"markdown\"],\"langAlias\":{},\"theme\":\"github-light\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[null],\"rehypePlugins\":[[null,{\"output\":\"html\"}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[]},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","teaching",["Map",11,12],"nju-ps/2026-spring/getting-started",{"id":11,"data":13,"body":24,"filePath":25,"digest":26,"legacyId":27,"deferredRender":16},{"title":14,"description":15,"published":16,"tags":17,"category":20,"course":21,"semester":22,"week":23},"开始使用这门课程","示例内容，用于验证 Markdown、数学公式、外部 C++ 源码引用和浏览器运行。",true,[18,19],"cpp","setup","lecture","nju-problem-solving","2026-spring",1,"import CppPlayground from '../../../../components/playground/CppPlayground.astro';\nimport helloVector from './hello-vector.cpp?raw';\n\n这是一篇占位课程材料。数学公式示例：$a^2+b^2=c^2$。\n\n普通代码仍然可以使用 Markdown 围栏：\n\n```cpp\n#include \u003Ciostream>\n\nint main() {\n    std::cout \u003C\u003C \"Hello, course!\\n\";\n}\n```\n\n## 一个可以运行的例子\n\n下面的组件引用同一目录下的 `hello-vector.cpp`。修改代码或输入后点击运行，\n编译会在浏览器的 Web Worker 中完成。\n\n\u003CCppPlayground\n  source={helloVector}\n  sourceName=\"hello-vector.cpp\"\n  stdin={`5\n5 1 4 3 9\n`}\n/>\n\n源码通过 `?raw` 在构建时读入页面，因此不会依赖一个运行时文件服务器。\n文章在没有 JavaScript、WebAssembly 不可用或工具链加载失败时，仍然保留可阅读的代码。\n\n平时仍要练习真实的本地流程：\n\n```bash\ng++ hello-vector.cpp -o hello-vector\n./hello-vector\n```","src/content/teaching/nju-ps/2026-spring/getting-started.mdx","0e3fecd20ad3f5f9","nju-ps/2026-spring/getting-started.mdx","notes",["Map",30,31,49,50],"example",{"id":30,"data":32,"body":36,"filePath":37,"digest":38,"rendered":39,"legacyId":48},{"title":33,"description":34,"published":16,"tags":35},"普通笔记示例","用于验证 Notes 内容集合的占位文章。",[30],"这里是普通笔记的占位内容。","src/content/notes/example.md","7a3a40786edeb2e5",{"html":40,"metadata":41},"\u003Cp>这里是普通笔记的占位内容。\u003C/p>",{"headings":42,"localImagePaths":43,"remoteImagePaths":44,"frontmatter":45,"imagePaths":47},[],[],[],{"title":33,"description":34,"tags":46,"published":16},[30],[],"example.md","markdown-demo",{"id":49,"data":51,"body":56,"filePath":57,"digest":58,"rendered":59,"legacyId":82},{"title":52,"description":53,"published":16,"tags":54},"用 Markdown 写一篇 C++ 学习笔记","一个可以直接修改的示例：文字、列表、数学公式和代码都会生成静态网页。",[55,18],"markdown","这篇文章的内容来自一个 **Markdown 文件**。顶部导航、页面宽度和字体由网站统一提供；写文章时，只需要关注正文。\n\n## 一个小问题\n\n给定正整数 $n$，求从 $1$ 到 $n$ 的整数之和。\n\n例如，输入 `5`，结果应该是 `15`。\n\n## 观察\n\n我们可以逐个累加，也可以使用公式：\n\n$$\n1 + 2 + \\cdots + n = \\frac{n(n+1)}{2}\n$$\n\n## C++ 代码\n\n```cpp\n#include \u003Ciostream>\n\nint main() {\n    long long n;\n    std::cin >> n;\n    std::cout \u003C\u003C n * (n + 1) / 2 \u003C\u003C '\\n';\n}\n```\n\n## 如何运行\n\n1. 将代码保存为 `main.cpp`。\n2. 在终端编译并运行：\n\n```bash\ng++ main.cpp -o main\n./main\n```\n\n3. 输入 `5`，检查输出是否为 `15`。\n\n## 复杂度与注意事项\n\n| 方法 | 时间复杂度 | 额外空间 |\n| --- | --- | --- |\n| 逐个累加 | $O(n)$ | $O(1)$ |\n| 使用公式 | $O(1)$ | $O(1)$ |\n\n> 注意乘法可能溢出：即使使用 `long long`，也仍然需要根据输入范围判断是否安全。\n\n## 继续阅读\n\n- [教学资源](/teaching/)\n- [算法笔记](/algorithms/)\n\n---\n\n试着修改这段文字、增加一个小节，或更换代码示例，再观察预览页面的变化。","src/content/notes/markdown-demo.md","767940db8b6fe4de",{"html":60,"metadata":61},"\u003Cp>这篇文章的内容来自一个 \u003Cstrong>Markdown 文件\u003C/strong>。顶部导航、页面宽度和字体由网站统一提供；写文章时，只需要关注正文。\u003C/p>\n\u003Ch2 id=\"一个小问题\">一个小问题\u003C/h2>\n\u003Cp>给定正整数 \u003Cspan class=\"katex\">\u003Cspan class=\"katex-html\" aria-hidden=\"true\">\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.4306em;\">\u003C/span>\u003Cspan class=\"mord mathnormal\">n\u003C/span>\u003C/span>\u003C/span>\u003C/span>，求从 \u003Cspan class=\"katex\">\u003Cspan class=\"katex-html\" aria-hidden=\"true\">\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.6444em;\">\u003C/span>\u003Cspan class=\"mord\">1\u003C/span>\u003C/span>\u003C/span>\u003C/span> 到 \u003Cspan class=\"katex\">\u003Cspan class=\"katex-html\" aria-hidden=\"true\">\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.4306em;\">\u003C/span>\u003Cspan class=\"mord mathnormal\">n\u003C/span>\u003C/span>\u003C/span>\u003C/span> 的整数之和。\u003C/p>\n\u003Cp>例如，输入 \u003Ccode>5\u003C/code>，结果应该是 \u003Ccode>15\u003C/code>。\u003C/p>\n\u003Ch2 id=\"观察\">观察\u003C/h2>\n\u003Cp>我们可以逐个累加，也可以使用公式：\u003C/p>\n\u003Cspan class=\"katex-display\">\u003Cspan class=\"katex\">\u003Cspan class=\"katex-html\" aria-hidden=\"true\">\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\">\u003C/span>\u003Cspan class=\"mord\">1\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003Cspan class=\"mbin\">+\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003C/span>\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\">\u003C/span>\u003Cspan class=\"mord\">2\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003Cspan class=\"mbin\">+\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003C/span>\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.6667em;vertical-align:-0.0833em;\">\u003C/span>\u003Cspan class=\"minner\">⋯\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003Cspan class=\"mbin\">+\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003C/span>\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:0.4306em;\">\u003C/span>\u003Cspan class=\"mord mathnormal\">n\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2778em;\">\u003C/span>\u003Cspan class=\"mrel\">=\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2778em;\">\u003C/span>\u003C/span>\u003Cspan class=\"base\">\u003Cspan class=\"strut\" style=\"height:2.113em;vertical-align:-0.686em;\">\u003C/span>\u003Cspan class=\"mord\">\u003Cspan class=\"mopen nulldelimiter\">\u003C/span>\u003Cspan class=\"mfrac\">\u003Cspan class=\"vlist-t vlist-t2\">\u003Cspan class=\"vlist-r\">\u003Cspan class=\"vlist\" style=\"height:1.427em;\">\u003Cspan style=\"top:-2.314em;\">\u003Cspan class=\"pstrut\" style=\"height:3em;\">\u003C/span>\u003Cspan class=\"mord\">\u003Cspan class=\"mord\">2\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"top:-3.23em;\">\u003Cspan class=\"pstrut\" style=\"height:3em;\">\u003C/span>\u003Cspan class=\"frac-line\" style=\"border-bottom-width:0.04em;\">\u003C/span>\u003C/span>\u003Cspan style=\"top:-3.677em;\">\u003Cspan class=\"pstrut\" style=\"height:3em;\">\u003C/span>\u003Cspan class=\"mord\">\u003Cspan class=\"mord mathnormal\">n\u003C/span>\u003Cspan class=\"mopen\">(\u003C/span>\u003Cspan class=\"mord mathnormal\">n\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003Cspan class=\"mbin\">+\u003C/span>\u003Cspan class=\"mspace\" style=\"margin-right:0.2222em;\">\u003C/span>\u003Cspan class=\"mord\">1\u003C/span>\u003Cspan class=\"mclose\">)\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan class=\"vlist-s\">​\u003C/span>\u003C/span>\u003Cspan class=\"vlist-r\">\u003Cspan class=\"vlist\" style=\"height:0.686em;\">\u003Cspan>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan class=\"mclose nulldelimiter\">\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\n\u003Ch2 id=\"c-代码\">C++ 代码\u003C/h2>\n\u003Cpre class=\"astro-code github-light\" style=\"background-color:#fff;color:#24292e; overflow-x: auto;\" tabindex=\"0\" data-language=\"cpp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">#include\u003C/span>\u003Cspan style=\"color:#032F62\"> &#x3C;iostream>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">int\u003C/span>\u003Cspan style=\"color:#6F42C1\"> main\u003C/span>\u003Cspan style=\"color:#24292E\">() {\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">    long\u003C/span>\u003Cspan style=\"color:#D73A49\"> long\u003C/span>\u003Cspan style=\"color:#24292E\"> n;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#6F42C1\">    std\u003C/span>\u003Cspan style=\"color:#24292E\">::cin \u003C/span>\u003Cspan style=\"color:#D73A49\">>>\u003C/span>\u003Cspan style=\"color:#24292E\"> n;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#6F42C1\">    std\u003C/span>\u003Cspan style=\"color:#24292E\">::cout \u003C/span>\u003Cspan style=\"color:#D