---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import SectionSidebar from '../components/navigation/SectionSidebar.astro';
import TableOfContents from '../components/navigation/TableOfContents.astro';
import { buildSidebar } from '../lib/navigation';
import { isPublished } from '../lib/content';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title = 'pmt2018', description = '个人学术主页与学习资料库', headings = [] } = Astro.props;
const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/teaching/', label: '教学', icon: 'teaching' },
  { href: '/notes/', label: '笔记', icon: 'notes' },
  { href: '/about/', label: '关于', icon: 'about' },
] as const;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const [teachingEntries, noteEntries] = await Promise.all([
  getCollection('teaching', (entry) => isPublished(entry)),
  getCollection('notes', (entry) => isPublished(entry)),
]);
const sidebarItems = buildSidebar(pathname, teachingEntries, noteEntries);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} · pmt2018</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">pmt2018</a>
        <details class="mobile-menu">
          <summary><span class="icon-label"><Icon name="menu" />菜单</span></summary>
          <nav aria-label="主导航">
            {navigation.map((item) => (
              <a class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined} href={item.href}>
                <span class="icon-label"><Icon name={item.icon} />{item.label}</span>
              </a>
            ))}
          </nav>
        </details>
        <nav class="desktop-menu" aria-label="主导航">
          {navigation.map((item) => (
            <a class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined} href={item.href}>
              <span class="icon-label"><Icon name={item.icon} />{item.label}</span>
            </a>
          ))}
        </nav>
      </header>
      <main id="main-content" tabindex="-1" class:list={{ 'has-docs-layout': sidebarItems.length > 0 }}>
        {sidebarItems.length > 0 ? (
          <div class="docs-layout">
            <SectionSidebar items={sidebarItems} pathname={pathname} />
            <details class="mobile-sidebar">
              <summary>浏览本栏目</summary>
              <SectionSidebar items={sidebarItems} pathname={pathname} />
            </details>
            <div class="docs-main"><slot /></div>
            <TableOfContents headings={headings} />
          </div>
        ) : <slot />}
      </main>
      <footer class="site-footer">
        <span>pmt2018 · 教学材料与学习笔记</span>
        <nav class="footer-links" aria-label="补充链接">
          <a href="/cv/" aria-current={pathname === '/cv/' ? 'page' : undefined}><span class="icon-label"><Icon name="file" />简历（待补充）</span></a>
          <a href="https://github.com/pmt-2018/pmt-2018.github.io"><span class="icon-label"><Icon name="source" />网站源码<Icon name="external" /></span></a>
        </nav>
      </footer>
    </div>
    <script>
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.table-of-contents a')];
      const headings = tocLinks
        .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) || ''))
        .filter((heading): heading is HTMLElement => Boolean(heading));
      if (tocLinks.length && headings.length) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tocLinks.forEach((link) => link.classList.toggle('is-current', link.hash === `#${entry.target.id}`));
            }
          });
        }, { rootMargin: '-15% 0px -70% 0px' });
        headings.forEach((heading) => observer.observe(heading));
      }
    </script>
  </body>
</html>
