---
import { Code } from 'astro:components';
import Icon from '../Icon.astro';

interface Props {
  /** Inline source, or source imported from a .cpp file with `?raw` in MDX. */
  code?: string;
  source?: string;
  stdin?: string;
  sourceName?: string;
}
const { code, source, stdin = '', sourceName = 'main.cpp' } = Astro.props;
const resolvedCode = source ?? code;
if (!resolvedCode) throw new Error('CppPlayground requires either a `source` or `code` prop.');
const editorId = `cpp-editor-${crypto.randomUUID()}`;
const inputId = `${editorId}-stdin`;
const helpId = `${editorId}-help`;
const inputHelpId = `${inputId}-help`;
const editorRows = Math.min(24, Math.max(8, resolvedCode.trimEnd().split('\n').length));
---

<section class="cpp-playground" aria-label="可运行的 C++ 示例" data-runtime-base={`${import.meta.env.BASE_URL}cpp-runtime/`}>
  <header class="cpp-toolbar">
    <div class="cpp-file"><strong>{sourceName}</strong><span>GNU C++17</span></div>
    <div class="cpp-actions">
      <button type="button" data-action="edit" aria-expanded="false" aria-controls={editorId}><Icon name="edit" /><span data-action-label>编辑</span></button>
      <button type="button" data-action="reset"><Icon name="reset" /><span>重置</span></button>
      <button type="button" data-action="run"><Icon name="run" /><span data-action-label>运行</span></button>
      <button type="button" data-action="stop" hidden><Icon name="stop" /><span>停止</span></button>
    </div>
  </header>
  <div class="cpp-code-area">
    <div class="cpp-fallback"><Code code={resolvedCode} lang="cpp" theme="github-light" /></div>
    <pre class="cpp-modified-code" hidden><code></code></pre>
    <div id={editorId} class="cpp-editor-pane" hidden>
      <div class="cpp-editor-host" hidden></div>
      <label class="cpp-plain-editor">源代码
        <textarea class="cpp-source" aria-describedby={helpId} spellcheck="false" autocapitalize="off" autocomplete="off" rows={editorRows}>{resolvedCode}</textarea>
      </label>
      <p id={helpId} class="cpp-editor-help" hidden>Tab 缩进 · Shift+Tab 取消缩进 · Esc 后按 Tab 离开编辑器 · Ctrl/Cmd+F 查找</p>
      <p class="cpp-editor-notice" role="status" hidden></p>
    </div>
  </div>
  <noscript><p class="cpp-noscript">启用 JavaScript 后可修改并运行示例。也可以复制代码，在本地编译运行。</p></noscript>
  <div class="cpp-interactive" hidden>
    <div class="cpp-io-grid">
      <div class="cpp-input-panel">
        <label for={inputId}>输入 <span>stdin</span></label>
        <textarea id={inputId} class="cpp-stdin" aria-describedby={inputHelpId} spellcheck="false" autocapitalize="off" autocomplete="off" rows="3">{stdin}</textarea>
        <p id={inputHelpId} class="cpp-help">输入一次性提供，读完后为 EOF。</p>
      </div>
      <section class="cpp-output-panel" aria-label="运行结果">
        <h3>运行结果</h3>
        <div class="cpp-stdout-panel"><h4>输出 <span>stdout</span></h4><pre class="cpp-stdout cpp-empty" tabindex="0">运行后，结果显示在这里。</pre></div>
        <details class="cpp-diagnostics-panel" hidden><summary>编译诊断</summary><pre class="cpp-diagnostics" tabindex="0"></pre></details>
        <div class="cpp-stderr-panel" hidden><h4>标准错误 <span>stderr</span></h4><pre class="cpp-stderr" tabindex="0"></pre></div>
        <div class="cpp-failure-panel" hidden><h4>运行环境错误</h4><pre class="cpp-failure" tabindex="0"></pre></div>
      </section>
    </div>
    <footer class="cpp-feedback">
      <p class="cpp-status" role="status" aria-live="polite">尚未运行</p>
      <progress class="cpp-progress" max="100" value="0" aria-label="编译器加载进度" hidden></progress>
      <p class="cpp-load-note cpp-help">首次运行需下载约 28 MB 编译器资源。</p>
      <details class="cpp-run-details" hidden><summary>运行详情</summary><p></p></details>
    </footer>
  </div>
</section>

<script>
  import './client';
</script>

<style>
  .cpp-playground { min-width: 0; margin: 2rem 0; border: 1px solid var(--line); border-radius: .4rem; background: #fff; }
  .cpp-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem; padding: .75rem 1rem; border-bottom: 1px solid var(--line); }
  .cpp-file { display: flex; flex-wrap: wrap; align-items: baseline; gap: .65rem; min-width: 0; }
  .cpp-file strong { font-size: .95rem; overflow-wrap: anywhere; }
  .cpp-file span, .cpp-help, .cpp-editor-help { color: #666; font-size: .85rem; }
  .cpp-actions { display: none; flex-wrap: wrap; gap: .5rem; }
  .cpp-enhanced .cpp-actions { display: flex; }
  .cpp-code-area { min-width: 0; background: #faf9fc; }
  .cpp-fallback :global(pre) { margin: 0; padding: 1rem; border: 0; border-radius: 0; font-size: .95rem; line-height: 1.65; overflow-x: auto; }
  .cpp-editor-pane, .cpp-editor-host { min-width: 0; }
  .cpp-editor-host :global(.cm-scroller) { max-height: 32rem; overflow: auto; }
  .cpp-editor-host :global(.cm-search) { display: flex; flex-wrap: wrap; gap: .35rem; padding: .5rem; }
  .cpp-editor-host :global(.cm-search input) { max-width: 100%; }
  .cpp-editor-help, .cpp-editor-notice { margin: 0; padding: .5rem 1rem; font-size: .85rem; }
  .cpp-editor-notice { color: #666; }
  .cpp-plain-editor { padding: 1rem; }
  .cpp-io-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  .cpp-input-panel, .cpp-output-panel { min-width: 0; padding: 1rem; }
  .cpp-output-panel { border-left: 1px solid var(--line); }
  [hidden] { display: none !important; }
  label { display: grid; gap: .45rem; font-size: .95rem; font-weight: 600; }
  label span, h4 span { margin-left: .25rem; color: #666; font-size: .85rem; font-weight: 400; }
  .cpp-input-panel label { display: block; margin-bottom: .5rem; }
  textarea { display: block; width: 100%; resize: vertical; padding: .65rem .75rem; border: 1px solid #ccc; border-radius: .25rem; background: #fff; color: #262626; font: 1rem/1.65 ui-monospace, SFMono-Regular, Consolas, monospace; tab-size: 4; }
  button { display: inline-flex; align-items: center; gap: .35rem; padding: .4rem .8rem; border: 1px solid #ccc; border-radius: .25rem; background: white; color: #262626; font: inherit; font-size: .9rem; cursor: pointer; }
  button[data-action="run"] { border-color: var(--accent-dark); background: var(--accent-dark); color: white; padding-inline: 1.2rem; }
  button:disabled { opacity: .6; cursor: default; }
  :is(button, textarea, pre, summary):focus-visible { outline: 2px solid var(--accent-dark); outline-offset: 3px; }
  .cpp-help { margin: .5rem 0 0; }
  .cpp-output-panel h3 { margin: 0 0 .65rem; font-size: .95rem; }
  .cpp-output-panel h4 { margin: .75rem 0 .35rem; font-size: .9rem; }
  .cpp-stdout-panel h4 { margin-top: 0; }
  .cpp-output-panel pre, .cpp-modified-code { min-height: 0; max-height: none; margin: 0; padding: .25rem 0; border: 0; border-radius: 0; background: transparent; white-space: pre-wrap; overflow-wrap: anywhere; font: .9rem/1.65 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .cpp-modified-code { padding: 1rem; }
  .cpp-modified-code code { padding: 0; background: none; }
  .cpp-empty { color: #666; font-family: inherit; }
  .cpp-diagnostics-panel { margin: .75rem 0 0; padding: 0; border: 0; border-radius: 0; }
  .cpp-diagnostics-panel summary, .cpp-run-details summary { cursor: pointer; font-size: .9rem; }
  .cpp-diagnostics-panel pre { margin-top: .5rem; }
  .cpp-diagnostics-panel summary, .cpp-failure-panel h4 { color: #a72b32; }
  .cpp-feedback { border-top: 1px solid var(--line); padding: .75rem 1rem; }
  .cpp-status { margin: 0; color: #555; font-size: .9rem; }
  .cpp-progress { display: block; width: min(100%, 16rem); margin-top: .5rem; accent-color: var(--accent-dark); }
  .cpp-run-details { margin: .5rem 0 0; padding: 0; border: 0; color: #666; }
  .cpp-run-details p { margin: .35rem 0 0; font-size: .85rem; }
  .cpp-noscript { padding: 0 1rem; }
  @media (max-width: 600px) {
    .cpp-io-grid { grid-template-columns: 1fr; }
    .cpp-output-panel { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (pointer: coarse) { button { min-height: 44px; } }
</style>
