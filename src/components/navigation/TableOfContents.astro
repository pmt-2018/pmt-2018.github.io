---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---
{visibleHeadings.length > 0 && (
  <aside class="table-of-contents" aria-label="本文目录">
    <div class="toc-label">本文目录</div>
    <nav>
      <ul>
        {visibleHeadings.map((heading) => (
          <li class:list={{ 'toc-subitem': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ul>
    </nav>
  </aside>
)}
