---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="首页">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="intro-column">
        <h1 id="home-title"><span class="home-greeting">你好，我是</span><span class="home-name">pmt2018。</span></h1>
        <p class="identity">学生 / 助教 / 算法与编程学习者</p>
      </div>
      <div class="bio-column">
        <p class="bio-lead">这里收录我的教学材料和算法笔记。</p>
        <p>我目前担任南京大学 Problem Solving 课程助教，主要负责编程部分。课程资料按学期整理，个人笔记按主题归档。</p>
        <a class="text-link" href="/teaching/nju-ps/2026-fall/">NJU Problem Solving · 2026 秋课程材料</a>
      </div>
    </section>

    <nav class="home-links" aria-label="内容入口">
      <a href="/teaching/"><strong><Icon name="teaching" />教学</strong><span>课程材料与编程实践</span></a>
      <a href="/notes/"><strong><Icon name="notes" />笔记</strong><span>算法、工具与长期学习记录</span></a>
    </nav>

  </div>
</BaseLayout>
